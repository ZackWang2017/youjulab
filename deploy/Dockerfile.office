# 构建上下文是仓库根目录。
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OFFICE_API_HOST=0.0.0.0 \
    OFFICE_API_PORT=8100 \
    OFFICE_FILE_ROOT=/data/office-files

COPY apps/office-backend/requirements.txt /tmp/requirements.txt
# 国内云主机直连 PyPI 很慢；腾讯云镜像加速。可用构建参数覆盖。
ARG PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
ARG PIP_TRUSTED_HOST=mirrors.cloud.tencent.com
RUN pip install --upgrade pip \
    && pip install --no-cache-dir \
      -i "${PIP_INDEX_URL}" \
      --trusted-host "${PIP_TRUSTED_HOST}" \
      -r /tmp/requirements.txt

COPY apps/office-backend /app/apps/office-backend
COPY skills /app/skills
COPY agents /app/agents
COPY youju-skills /app/youju-skills
COPY mcp-server/external-tools /app/mcp-server/external-tools
COPY mcp-server/local-tools /app/mcp-server/local-tools

RUN mkdir -p /data/office-files

WORKDIR /app/apps/office-backend
EXPOSE 8100

CMD ["python", "server.py"]
