# 构建上下文是仓库根目录。
FROM node:22-bookworm-slim AS build

WORKDIR /src/apps/office-copilot-web

COPY apps/office-copilot-web/package.json apps/office-copilot-web/package-lock.json ./
ARG NPM_REGISTRY=https://registry.npmmirror.com
RUN npm ci --registry="${NPM_REGISTRY}"

COPY apps/office-copilot-web/ ./
# Vite + Univer 构建需要较大堆；8G 机器建议先建 2G swap 再构建。
RUN NODE_OPTIONS=--max-old-space-size=4096 npm run build

FROM nginx:1.27-alpine

RUN sed -i "s@dl-cdn.alpinelinux.org@mirrors.aliyun.com@g" /etc/apk/repositories

RUN apk add --no-cache wget openssl \
    && rm -f /etc/nginx/conf.d/default.conf
COPY deploy/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/nginx/docker-entrypoint.sh /docker-entrypoint-youjulab.sh
RUN chmod +x /docker-entrypoint-youjulab.sh
COPY --from=build /src/apps/office-copilot-web/dist /usr/share/nginx/html

EXPOSE 80 443
ENTRYPOINT ["/docker-entrypoint-youjulab.sh"]
CMD ["nginx", "-g", "daemon off;"]
