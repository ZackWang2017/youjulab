FINANCE_MCP_TRANSPORT=http
FINANCE_MCP_HOST=127.0.0.1
FINANCE_MCP_PORT=8000
# 模型来源：0=平台统一配置；1=当前用户在设置中保存的自有 Key；3=按用户选择（当前仅自有模型）。
LLM_CONFIG_SET=0
# 用户自有模型密钥的 AES-256-GCM 主密钥。用以下命令生成后保存到部署环境，绝不提交到版本库：
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OFFICE_MODEL_CREDENTIALS_KEY=
# 平台 DeepSeek（OpenAI 兼容）。仅 LLM_CONFIG_SET=0 时使用；填好后重启 office-backend。
OFFICE_MODEL_BASE_URL=https://api.deepseek.com
OFFICE_MODEL_NAME=deepseek-flash
OFFICE_MODEL_API_KEY=
# 兼容旧名；留空则使用 MCP_ACCESS_TOKEN
FINANCE_MCP_TOKEN=

OFFICE_API_HOST=127.0.0.1
OFFICE_API_PORT=8100
OFFICE_MONGO_URL=mongodb://127.0.0.1:27017
OFFICE_MONGO_DB=office
OFFICE_FILE_ROOT=data/office-files
OFFICE_JWT_SECRET=office-dev-secret-please-change-32
# 财务 MCP（/mcp）的静态 32 位访问令牌。表格入口改用每个用户自己的 token。
MCP_ACCESS_TOKEN=invpdevstatic32tokenpleasechange
# PDF 向量索引（上传后异步写入）。需本机 Postgres + pgvector，以及 embedding 服务。
OFFICE_PG_URL=postgresql://user:password@localhost:5432/office_vectors
OFFICE_EMBEDDING_PROVIDER=ollama
OFFICE_EMBEDDING_BASE_URL=http://127.0.0.1:11434
OFFICE_EMBEDDING_MODEL=bge-m3
OFFICE_EMBEDDING_DIM=1024
# OFFICE_EMBEDDING_API_KEY=
DIGEST_TZ=Asia/Shanghai
# 可选：自建 RSSHub 根地址，用于「RSSHub路由」类型来源，如 https://rsshub.example.com
DIGEST_RSSHUB_BASE=
# 指定公众号的 weread 来源不需要根地址。mcp-server 启动时在终端打印微信读书登录二维码，登录态写在 data/weread-session.json。

# 外部工具 MCP（/mcp/external-tools）：百度千帆 AI Search
BAIDU_QIANFAN_API_KEY=
# Google CSE：无法全网搜 → 只用一个 CX，控制台「要搜索的网站」= 下方三组并集
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
# 垂直主题站点（逗号分隔）。并集填进 GOOGLE_CSE_CX；调用时 topic 用对应子集收窄
SEARCH_SITES_FINANCE=finance.eastmoney.com,www.cninfo.com.cn,www.sse.com.cn,www.szse.cn,www.cls.cn,finance.sina.com.cn,www.stcn.com,www.cs.com.cn,www.yicai.com,www.wallstreetcn.com,www.investing.com,finance.yahoo.com
SEARCH_SITES_ACCOUNTING=kjs.mof.gov.cn,www.casc.org.cn,www.cicpa.org.cn,www.mof.gov.cn,www.csrc.gov.cn,www.ifrs.org,www.fasb.org,www.sec.gov
SEARCH_SITES_ENCYCLOPEDIA=baike.baidu.com,zh.wikipedia.org,en.wikipedia.org,wiki.mbalib.com,www.investopedia.com
# 可选：显式写全集（默认自动合并上面三组）。一般可留空
SEARCH_SITES=
# 搜索开关与每日限额（计数存 Postgres 表 external_search_daily，时区 SEARCH_USAGE_TZ / DIGEST_TZ）
SEARCH_BAIDU_ENABLED=1
SEARCH_BAIKE_ENABLED=1
SEARCH_GOOGLE_ENABLED=0
SEARCH_BAIDU_DAILY_LIMIT=50
SEARCH_BAIKE_DAILY_LIMIT=50
SEARCH_GOOGLE_DAILY_LIMIT=100
SEARCH_USAGE_TZ=Asia/Shanghai

# 持仓管理（mcp-server 进程读取）。数据存 finresearch 库（FINANCE_DATABASE_URL / FINANCE_DB_*），
# 收盘后计划任务：工作日固定时间快照汇率 → 补收盘价 → 按净值法重算上一交易日净值。
SCHEDULER_ENABLED=1
SCHEDULER_TZ=Asia/Shanghai
PORTFOLIO_CLOSE_JOB_AT=17:00
