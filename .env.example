FINANCE_MCP_TRANSPORT=http
FINANCE_MCP_HOST=0.0.0.0
FINANCE_MCP_PORT=8000
FINANCE_STORE=postgres
FINANCE_DB_HOST=127.0.0.1
FINANCE_DB_PORT=5432
FINANCE_DB_NAME=youjulab_finresearch
FINANCE_DB_USER=youjulab
FINANCE_DB_PASSWORD=
# Set server-side random secrets; never include these in a desktop package.
ACCOUNT_JWT_SECRET=

# Library Information is local: rows share OFFICE_SQLITE_PATH (office.sqlite).
# No FINANCE_DATABASE_URL / remote PostgreSQL is used for news storage.
# Per-user WeRead sessions are kept under local userData/information/weread/.
# Optional local collector settings (desktop launch environment):
# DIGEST_RSSHUB_BASE=https://rsshub.example.com
# OFFICE_WEREAD_BROWSER=1
# OFFICE_WEREAD_BROWSER_CHANNEL=chrome
# OFFICE_WEREAD_BROWSER_EXECUTABLE=/absolute/path/to/chrome
MCP_ACCESS_TOKEN=

# 远程 mcp（登录、持仓、embedding）。调试用本机；部署后改成服务器地址，
# 或在登录窗 / 设置里改同一项。embedding 固定为该地址下的 /api/embeddings。
MCP_REMOTE_BASE_URL=http://192.168.0.5:8000

OFFICE_API_HOST=127.0.0.1
OFFICE_API_PORT=8100
OFFICE_STORE=sqlite
# 桌面开发/打包请与 Electron userData 对齐，避免出现两套 PDF/数据库：
# OFFICE_SQLITE_PATH=~/Library/Application Support/youjulab-desktop/office.sqlite
# OFFICE_VECTOR_SQLITE_PATH=~/Library/Application Support/youjulab-desktop/office-vectors.sqlite
# OFFICE_FILE_ROOT=~/Library/Application Support/youjulab-desktop/office-files
# 仅隔离调试才用仓库 data/：
# Leave paths unset to use OS userData (macOS/Windows/Linux).
# OFFICE_SQLITE_PATH=
OFFICE_VECTOR_BACKEND=sqlite
# OFFICE_VECTOR_SQLITE_PATH=
# 本地 PDF 目录。登录窗和设置页可以改；留空则用这个默认值。
# OFFICE_FILE_ROOT=
OFFICE_JWT_SECRET=office-dev-secret-please-change-32
OFFICE_EMBEDDING_DIM=1024

# 模型来源：0=平台统一配置；1=当前用户在设置中保存的自有 Key；3=按用户选择（当前仅自有模型）。
LLM_CONFIG_SET=0
# 用户自有模型密钥的 AES-256-GCM 主密钥。用以下命令生成后保存到部署环境，绝不提交到版本库：
# python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
OFFICE_MODEL_CREDENTIALS_KEY=
# 平台 DeepSeek（OpenAI 兼容）。仅 LLM_CONFIG_SET=0 时使用；填好后重启 office-backend。
OFFICE_MODEL_BASE_URL=https://api.deepseek.com
OFFICE_MODEL_NAME=deepseek-flash
OFFICE_MODEL_API_KEY=
