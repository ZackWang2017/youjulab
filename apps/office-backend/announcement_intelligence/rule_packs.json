{
  "version": 2,
  "document_type_packs": {
    "annual_report": "financial_report",
    "interim_report": "financial_report",
    "announcement": "announcement",
    "prospectus": "prospectus",
    "generic": "generic"
  },
  "defaults": {
    "numbered": true,
    "bold": true,
    "min_font_percentile": 90,
    "max_length": 56,
    "unnumbered_max_length": 34,
    "numbered_max_length": 40,
    "numbered_max_punctuation": 2,
    "min_length": 2,
    "top_bottom_margin": 0.035,
    "max_level": 6,
    "max_punctuation": 2,
    "max_digit_ratio": 0.58,
    "font_size_min_delta": 0.5,
    "bold_min_vertical_gap": 14,
    "bold_max_width_ratio": 0.78,
    "bold_max_same_line_blocks": 1,
    "number_patterns": [
      "^第\\s*[一二三四五六七八九十百千万〇零0-9]+\\s*[编章节部分卷篇条款项]",
      "^\\s*[壹贰叁肆伍陆柒捌玖拾佰仟]+\\s*[、．.]",
      "^\\s*[一二三四五六七八九十百千万〇零]+\\s*[、．.]",
      "^\\s*[（(]\\s*[一二三四五六七八九十百千万〇零]+\\s*[)）]",
      "^\\s*[（(]\\s*[壹贰叁肆伍陆柒捌玖拾佰仟]+\\s*[)）]",
      "^\\s*[0-9０-９]+\\s*[、．.](?![0-9０-９])\\s*",
      "^\\s*[0-9０-９]+(?:\\s*[.．]\\s*[0-9０-９]+){1,5}\\s*[、．.]?\\s*",
      "^\\s*[（(]\\s*[0-9０-９]+(?:\\s*[.．]\\s*[0-9０-９]+){0,5}\\s*[)）]",
      "^\\s*[0-9０-９]+\\s*[)）]",
      "^\\s*[【[]\\s*[0-9０-９]+(?:\\s*[.．]\\s*[0-9０-９]+){0,5}\\s*[]】]",
      "^\\s*[①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳]\\s*",
      "^\\s*[❶❷❸❹❺❻❼❽❾❿]\\s*",
      "^\\s*[A-ZＡ-Ｚa-zａ-ｚ]\\s*[、．.)）](?![A-Za-zＡ-Ｚａ-ｚ])",
      "^\\s*[（(]\\s*[A-ZＡ-Ｚa-zａ-ｚ]\\s*[)）]",
      "^\\s*[IVXLCDM]+\\s*[、．.)）]",
      "^\\s*[（(]\\s*[IVXLCDMivxlcdm]+\\s*[)）]",
      "^\\s*(?:No\\.?|Item)\\s*[0-9０-９]+\\s*[:：．.)）]",
      "^\\s*(?:[-‐‑‒–—―－]|[•◦▪▫■□◆◇●○◎◉◌·‧※]|[★☆✦✧✩✪✫✬✭✮✯]|[✓✔☑✕✖]|[➢➣➤➥➦➧➨➩➪➫➬➭➮➯]|[▶▸▹►▻])\\s+",
      "^\\s*(?:Part|Chapter|Section|Article)\\s+[0-9IVXLC]+(?:[.：:]|\\s)",
      "^\\s*(?:Appendix|Annex|Schedule)\\s+[A-Z0-9IVXLC]+(?:[.：:]|\\s)",
      "^\\s*(?:[一二三四五六七八九十]+是|首先|其次|再次|最后)\\s*[，,:：]",
      "^\\s*(?:附录|附件|附表|附注|释义|目录|定义|特别提示|重要提示)\\b"
    ],
    "number_level_patterns": [
      {"pattern": "^第\\s*[一二三四五六七八九十百千万〇零0-9]+\\s*[编章节部分卷篇]", "level": 1},
      {"pattern": "^\\s*[壹贰叁肆伍陆柒捌玖拾佰仟]+\\s*[、．.]", "level": 1},
      {"pattern": "^\\s*[一二三四五六七八九十百千万〇零]+\\s*[、．.]", "level": 1},
      {"pattern": "^\\s*[0-9０-９]+\\s*[、．.](?![0-9０-９])", "level": 1},
      {"pattern": "^\\s*[（(]\\s*[一二三四五六七八九十百千万〇零]+\\s*[)）]", "level": 2},
      {"pattern": "^\\s*[0-9０-９]+(?:\\s*[.．]\\s*[0-9０-９]+){1}\\s*[、．.]?", "level": 2},
      {"pattern": "^\\s*[（(]\\s*[0-9０-９]+(?:\\s*[.．]\\s*[0-9０-９]+){0,5}\\s*[)）]", "level": 2},
      {"pattern": "^\\s*[0-9０-９]+\\s*[)）]", "level": 2},
      {"pattern": "^\\s*[【[]\\s*[0-9０-９]+(?:\\s*[.．]\\s*[0-9０-９]+){0,5}\\s*[]】]", "level": 2},
      {"pattern": "^\\s*[①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳❶❷❸❹❺❻❼❽❾❿]", "level": 3},
      {"pattern": "^\\s*[0-9０-９]+(?:\\s*[.．]\\s*[0-9０-９]+){2}\\s*[、．.]?", "level": 3},
      {"pattern": "^\\s*[0-9０-９]+(?:\\s*[.．]\\s*[0-9０-９]+){3,5}\\s*[、．.]?", "level": 4},
      {"pattern": "^\\s*[A-ZＡ-Ｚa-zａ-ｚ]\\s*[、．.)）](?![A-Za-zＡ-Ｚａ-ｚ])", "level": 2},
      {"pattern": "^\\s*[IVXLCDM]+\\s*[、．.)）]", "level": 1},
      {"pattern": "^\\s*[（(]\\s*[IVXLCDMivxlcdm]+\\s*[)）]", "level": 2},
      {"pattern": "^\\s*(?:[-‐‑‒–—―－]|[•◦▪▫■□◆◇●○◎◉◌·‧※]|[★☆✦✧✩✪✫✬✭✮✯]|[✓✔☑✕✖]|[➢➣➤➥➦➧➨➩➪➫➬➭➮➯]|[▶▸▹►▻])\\s+", "level": 2},
      {"pattern": "^\\s*(?:Part|Chapter|Section|Article)", "level": 1},
      {"pattern": "^\\s*(?:Appendix|Annex|Schedule|附录|附件|附表|附注)", "level": 1}
    ],
    "exclude_patterns": [
      "^\\s*(?:第\\s*)?[0-9]+\\s*页\\s*$",
      "^\\s*[0-9]+\\s*/\\s*[0-9]+\\s*$",
      "^\\s*(?:证券代码|证券简称|公告编号|股票代码|股票简称)[：:]",
      "^\\s*[（(]\\s*股份代號[：:]",
      "^\\s*(?:单位|币种|金额单位|注|资料来源|数据来源|来源)[：:]",
      "^\\s*(?:公司名称|地址|电话|传真|网址|电子信箱)[：:]",
      "^\\s*(?:目录|CONTENTS)\\s*$",
      "^\\s*(?:表|图)\\s*[0-9一二三四五六七八九十]+[：:.]",
      "^\\s*[0-9,，.．%％+\\-—()（）:/： ]+\\s*$",
      "^\\s*[0-9]+(?:[.．][0-9]+)?\\s*[%％]",
      "^\\s*[0-9]+(?:[.．][0-9]+)?\\s*(?:億|亿|萬|万|美元|港元|人民幣|人民币|歐元|欧元|日圓|日元)",
      "^\\s*(?:人民币|港币|美元|亿元|万元|千元|元)\\s*$",
      "^\\s*(?:报告期|本期|上期|同比|环比|项目)\\s*$",
      "^\\s*[–—-]+\\s*[0-9]+\\s*[–—-]+\\s*$",
      "^\\s*「[^」]+」\\s*$"
    ],
    "body_terminal_patterns": [
      "[。；;！？!?]$",
      "，[^，]{8,}$",
      "(?:的|了|是|为|及|和|或|与|等)$"
    ],
    "body_lead_patterns": [
      "^\\s*本公司(?:在|于|的|认为|已|将|不存在|主营|按照|根据|通过)",
      "^\\s*(?:报告期内|截至报告期末|根据|经审计|经核查|由于|为了|其中|本次)(?:，|公司|本公司|本集团|我们|发行人)",
      "^\\s*(?:我们|本行|本企业|本基金)(?:认为|在|将|已|的|于)"
    ],
    "table_like_patterns": [
      "\\t",
      "\\s{5,}",
      "(?:\\d+[,.，]){3,}",
      "(?:^|\\s)(?:20\\d{2}|19\\d{2})(?:年|/|-)",
      "(?:^|\\s)(?:同比|环比|占比|增长率|毛利率|净利率)(?:\\s|$)"
    ]
  },
  "rule_packs": {
    "generic": {},
    "announcement": {
      "min_font_percentile": 88,
      "max_length": 52,
      "unnumbered_max_length": 30,
      "numbered_max_length": 32
    },
    "financial_report": {
      "min_font_percentile": 92,
      "max_length": 62,
      "unnumbered_max_length": 38,
      "numbered_max_length": 44,
      "top_bottom_margin": 0.025
    },
    "prospectus": {
      "min_font_percentile": 91,
      "max_length": 68,
      "unnumbered_max_length": 40,
      "numbered_max_length": 46,
      "top_bottom_margin": 0.025
    }
  }
}
