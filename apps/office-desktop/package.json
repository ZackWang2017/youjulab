{
  "name": "youjulab-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "youjulab Electron shell — local SqliteStore + remote embedding/portfolio",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:sidecar": "bash sidecar/build.sh",
    "build:mcp-sidecar": "bash mcp-sidecar/build.sh",
    "build:services": "npm run build:sidecar && npm run build:mcp-sidecar",
    "build:desktop": "npm --prefix ../office-copilot-web run build && npm run build:services && npm run pack:mac",
    "pack": "electron-builder --dir",
    "pack:mac": "electron-builder --mac --dir",
    "dist": "electron-builder --mac --win",
    "dist:mac": "electron-builder --mac dmg",
    "dist:mac:full": "npm run build:services && npm run dist:mac"
  },
  "build": {
    "appId": "com.youjulab.desktop",
    "productName": "youjulab",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "files": [
      "main.mjs",
      "preload.cjs",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../office-copilot-web/dist",
        "to": "web"
      },
      {
        "from": "sidecar/dist/youju-office-backend",
        "to": "sidecar/youju-office-backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "mcp-sidecar/dist/youju-mcp-server",
        "to": "mcp-sidecar/youju-mcp-server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
